{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/sdk/types",
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sdk.tsbuildinfo"
  },
  "include": [
    "src/plugin-api.ts",
    "src/authoring-api.ts",
    "src/sdk-capabilities.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/test/**"
  ]
}
