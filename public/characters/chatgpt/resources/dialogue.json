  "rules": [
    {
      "id": "character-tap-defeated",
      "on": [
        {
          "type": "hoc-core/character-tap#tap",
          "apiVersion": 1
        }
      ],
      "when": {
        "all": [
          {
            "primitive": "core.phase",
            "apiVersion": 1,
            "args": {},
            "test": {
              "eq": "roulette-result"
            }
          },
          {
            "primitive": "core.trigger-actor",
            "apiVersion": 1,
            "args": {},
            "test": {
              "eq": "opponent"
            }
          },
          {
            "primitive": "core.trigger-result",
            "apiVersion": 1,
            "args": {},
            "test": {
              "eq": "fired"
            }
          }
        ]
      },
      "poolId": "CHARACTER_TAP_DEFEATED",
      "portrait": {
        "image": "tap.png",
        "alt": "ChatGPT 被戳后生气"
      }
    },
    {
      "id": "character-tap-roulette",
      "on": [
        {
          "type": "hoc-core/character-tap#tap",
          "apiVersion": 1
        }
      ],
      "when": {
        "any": [
          {
            "primitive": "core.phase",
            "apiVersion": 1,
            "args": {},
            "test": {
              "eq": "roulette-reaction"
            }
          },
          {
            "primitive": "core.phase",
            "apiVersion": 1,
            "args": {},
            "test": {
              "eq": "roulette-trigger"
            }
          }
        ]
      },
      "poolId": "CHARACTER_TAP_ROULETTE"
    },
