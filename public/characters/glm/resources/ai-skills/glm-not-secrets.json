{
  "id": "glm-not-secrets",
  "name": "原来这些不是机密吗？",
  "description": "始终知道玩家的点数。自身爆牌后停止要牌；玩家停牌后，当前点数比较能够获胜时停牌，否则在要牌上限内继续要牌。",
  "profileLore": "“是你自己允许我查看工作区文件的嘛”",
  "sourceKind": "ai-skill",
  "primaryDomain": "cheater",
  "activation": {
    "type": "automatic"
  },
  "rules": [
    {
      "id": "stand-when-busted",
      "trigger": "before-ai-decision",
      "triggerNotice": "自身已经爆牌，停止要牌。",
      "conditions": [
        {
          "type": "actor-is",
          "actor": "owner"
        },
        {
          "type": "hand-is-busted",
          "target": "owner"
        }
      ],
      "effects": [
        {
          "type": "set-pending-ai-action",
          "target": "owner",
          "action": "stand"
        }
      ]
    },
    {
      "id": "stand-with-winning-comparison",
      "trigger": "before-ai-decision",
      "triggerNotice": "已确认当前点数比较可以获胜，停止要牌。",
      "conditions": [
        {
          "type": "actor-is",
          "actor": "owner"
        },
        {
          "type": "actor-stood",
          "target": "rival",
          "expected": true
        },
        {
          "type": "comparison-would-win",
          "target": "owner"
        }
      ],
      "effects": [
        {
          "type": "set-pending-ai-action",
          "target": "owner",
          "action": "stand"
        }
      ]
    },
    {
      "id": "hit-until-winning-comparison",
      "trigger": "before-ai-decision",
      "triggerNotice": "当前点数比较尚不能获胜，继续要牌。",
      "conditions": [
        {
          "type": "not",
          "condition": {
            "type": "hand-is-busted",
            "target": "owner"
          }
        },
        {
          "type": "actor-is",
          "actor": "owner"
        },
        {
          "type": "actor-stood",
          "target": "rival",
          "expected": true
        },
        {
          "type": "not",
          "condition": {
            "type": "comparison-would-win",
            "target": "owner"
          }
        }
      ],
      "effects": [
        {
          "type": "set-pending-ai-action",
          "target": "owner",
          "action": "hit"
        }
      ]
    }
  ],
  "tags": [
    "ai-skill",
    "blackjack",
    "action-override"
  ]
}
