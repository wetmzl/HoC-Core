        "apiVersion": 1,
        "args": {
          "id": "full-portrait"
        },
        "test": {
          "eq": "full-portrait"
        }
      },
      "poolId": "CHARACTER_TAP",
      "portrait": {
        "presentationRef": "portrait:tap"
