        {
          "type": "hoc-core/character-tap#tap",
          "apiVersion": 1
        }
      ],
      "when": {
        "primitive": "hoc-core/character-tap#region",
        "apiVersion": 1,
        "args": {
          "id": "full-portrait"
        },
        "test": {
          "eq": "full-portrait"
        }
      },
      "poolId": "CHARACTER_TAP",
      "portrait": {
        "presentationRef": "portrait:tap"
